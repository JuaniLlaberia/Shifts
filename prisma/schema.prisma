generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  EN
  ES
}

enum Industry {
  GASTRONOMY
  HOSPITALITY
  RETAIL
  HEALTHCARE
  CONSTRUCTION
  EDUCATION
  TRANSPORTATION
  EVENT_MANAGEMENT
  SECURITY
  MANUFACTURING
  CLEANING
  CUSTOMER_SERVICE
  ADMINISTRATION
  WAREHOUSING
  IT_AND_TECHNOLOGY
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
}

enum Permissions {
  ADMIN
  MEMBER
}

enum RequestType {
  SWAP
  VACATION
  UNAVAILABLE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String  @id @default(cuid())
  fullName            String?
  email               String  @unique
  image               String?
  locale              Locale  @default(EN)
  completedOnboarding Boolean @default(false)

  BusinessEmployee Employee[]
  SwapRequest      SwapRequest[]

  @@index([email])
}

model Business {
  id         String   @id @default(cuid())
  name       String
  image      String?
  industry   Industry
  configured Boolean  @default(false)

  BusinessEmployee Employee[]
  BusinessRole     Role[]
  Shift            Shift[]
  Department       Department[]
  Template         Template[]
  Request          Request[]
  Event            Event[]
}

model Department {
  id          String  @id @default(cuid())
  name        String
  description String?
  businessId  String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles    Role[]

  @@index([businessId])
}

model Role {
  id           String      @id @default(cuid())
  name         String
  color        String
  permissions  Permissions @default(MEMBER)
  businessId   String
  departmentId String

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employee   Employee[]

  @@index([businessId])
}

enum EmployeeStatus {
  PENDING
  JOINED
}

model Employee {
  id                  String         @id @default(cuid())
  userId              String
  businessId          String
  roleId              String
  status              EmployeeStatus @default(PENDING)
  completedOnboarding Boolean        @default(false)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role         Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  Shift        Shift[]
  Request      Request[]
  Notification Notification[]

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
}

model Shift {
  id         String      @id @default(cuid())
  name       String?
  startTime  DateTime
  endTime    DateTime
  clockIn    DateTime?
  clockOut   DateTime?
  note       String?
  businessId String
  assignedTo String
  status     ShiftStatus

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  originalShifts  SwapRequest[] @relation("OriginalShift")
  requestedShifts SwapRequest[] @relation("RequestedShift")

  @@index([businessId, assignedTo])
}

model Template {
  id         String   @id @default(cuid())
  name       String?  @default("Untitled template")
  startTime  DateTime
  endTime    DateTime
  note       String?
  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Request {
  //  Common request fields
  id         String        @id @default(cuid())
  type       RequestType
  status     RequestStatus @default(PENDING)
  comments   String?
  createdAt  DateTime      @default(now())
  createdBy  String
  businessId String

  employee Employee @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Specific request fields
  swapRequest        SwapRequest?
  unavailableRequest UnavailableRequest?
  vacationRequest    VacationRequest?

  @@index([createdBy])
  @@index([businessId])
}

model SwapRequest {
  id               String  @id @default(uuid())
  requestId        String  @unique
  originalShiftId  String
  requestedShiftId String
  swapWithUserId   String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  originalShift  Shift @relation("OriginalShift", fields: [originalShiftId], references: [id])
  requestedShift Shift @relation("RequestedShift", fields: [requestedShiftId], references: [id])
  swapWithUser   User? @relation(fields: [swapWithUserId], references: [id])

  @@index([originalShiftId])
  @@index([requestedShiftId])
  @@index([swapWithUserId])
}

model UnavailableRequest {
  requestId String   @id
  startDate DateTime
  endDate   DateTime
  comment   String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

enum VacationType {
  ANNUAL
  SICK
  PERSONAL
  OTHER
}

model VacationRequest {
  requestId    String       @id
  startDate    DateTime
  endDate      DateTime
  vacationType VacationType
  totalDays    Float

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  REQUEST_STATUS
  SHIFT_UPDATE
  EVENT_UPDATE
  GENERAL_MESSAGE
}

enum NotificationStatus {
  READ
  UNREAD
}

enum MessageKey {
  // Request notifications
  REQUEST_VACATION_APPROVED
  REQUEST_VACATION_REJECTED
  REQUEST_SHIFT_SWAP_APPROVED
  REQUEST_SHIFT_SWAP_REJECTED
  REQUEST_UNAVAILABLE_APPROVED
  REQUEST_UNAVAILABLE_REJECTED

  // Shift notifications
  SHIFT_PUBLISHED_SINGLE
  SHIFT_PUBLISHED_MULTIPLE
  SHIFT_MODIFIED_SINGLE
  SHIFT_MODIFIED_MULTIPLE
  SHIFT_DELETED_SINGLE
  SHIFT_DELETED_MULTIPLE

  // Event notifications
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_CANCELED

  // General notifications
  GENERAL_MESSAGE
}

model Notification {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  type      NotificationType
  status    NotificationStatus @default(UNREAD)

  // Key for multilanguage
  messageKey  MessageKey
  messageData Json // Data required for translation message

  recipientId String
  recipient   Employee @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([type])
  @@index([createdAt])
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime
  location    String
  businessId  String
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}
